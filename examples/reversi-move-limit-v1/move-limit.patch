--- /dev/null
+++ b/tests/acceptance.gd
@@ -0,0 +1,99 @@
+extends SceneTree
+
+var checks := 0
+var failures := 0
+var session: Node
+var stage: Node
+
+func check(ok: bool, label: String) -> void:
+	checks += 1
+	if not ok:
+		failures += 1
+	print("%s %s" % ["PASS" if ok else "FAIL", label])
+
+func _initialize() -> void:
+	call_deferred("run")
+
+func wait_seconds(seconds: float) -> void:
+	await create_timer(seconds).timeout
+
+func scene(path: String) -> Node:
+	change_scene_to_file(path)
+	await process_frame
+	await process_frame
+	return current_scene
+
+func move(game: Node) -> void:
+	var cells: Array = game._moves.keys()
+	game._on_cell_clicked(cells[0])
+	await wait_seconds(0.8)
+
+func run() -> void:
+	session = root.get_node("Session")
+	stage = root.get_node("Stage")
+	root.get_node("Settings").set_value("a11y/reduced_motion", true)
+	var setup: Node = await scene("res://screens/setup/setup.tscn")
+	check(setup._limit == 0 and "UNLIMITED" in setup._limit_button.text, "default unlimited visible")
+	setup._limit_button.pressed.emit()
+	check(setup._limit == 12 and "12 TOTAL" in setup._limit_button.text, "limit control selects 12 total")
+	check(setup._limit_button.get_minimum_size().x <= 1392, "limit label fits allocated width")
+	check(setup._limit_button.get_minimum_size().y <= 108, "limit control fits allocated height")
+	setup._limit_button.pressed.emit()
+	check(setup._limit == 24, "limit control selects 24")
+	setup._limit_button.pressed.emit()
+	check(setup._limit == 0, "limit control cycles back to unlimited")
+	session.configure(1, 0, 1, 2)
+	var game: Node = await scene("res://screens/game/game.tscn")
+	check(game._board.score(1) == 2 and game._board.score(2) == 2 and game._moves.size() == 4, "standard opening retained")
+	game._on_cell_clicked(Vector2i(0, 0))
+	check(game._board.move_count() == 0, "illegal click does not consume limit")
+	await move(game)
+	check(game._board.move_count() == 1 and not game._over, "first legal move increments once")
+	check("Moves 1/2" in game._flip_label.text, "remaining progress feedback")
+	game._open_pause()
+	check(paused and game._pause != null, "pause opens")
+	game._pause.restart_requested.emit()
+	await wait_seconds(0.1)
+	check(not paused and game._board.move_count() == 0 and game._board.score(1) == 2, "pause restart resets board/count")
+	check(session.move_limit == 2 and session.result.is_empty(), "restart preserves limit and clears result")
+	check(game._last_cell == Vector2i(-1, -1) and game._played.is_empty(), "restart clears prior move history")
+	await move(game)
+	# Two rapid clicks must not consume two placements while animation is busy.
+	var next_cell: Vector2i = game._moves.keys()[0]
+	game._on_cell_clicked(next_cell)
+	game._on_cell_clicked(next_cell)
+	await wait_seconds(1.5)
+	check(current_scene.scene_file_path.ends_with("result.tscn"), "limit transitions to actual result screen")
+	check(session.result.get("moves") == 2 and session.result.get("reason") == "Move limit reached.", "exact total-placement limit and reason")
+	check("Move limit reached." in current_scene._subline.text, "result displays limit reason")
+	check(current_scene._subline.get_minimum_size().x <= 2080, "result reason fits design width")
+	current_scene._play_again.pressed.emit()
+	await wait_seconds(0.8)
+	check(current_scene.scene_file_path.ends_with("game.tscn") and current_scene._board.move_count() == 0 and session.move_limit == 2, "play again starts fresh with selected limit")
+	session.configure(1, 0, 1, 0)
+	game = await scene("res://screens/game/game.tscn")
+	for i in range(3):
+		await move(game)
+	check(game._board.move_count() == 3 and not game._over and session.result.is_empty(), "unlimited regression continues beyond short limit")
+	# Restart during the CPU delay: old delayed move must not act in new match.
+	session.configure(0, 0, 2, 12)
+	game = await scene("res://screens/game/game.tscn")
+	await wait_seconds(0.1)
+	game._restart()
+	game._restart()
+	await wait_seconds(1.5)
+	check(game._board.move_count() == 1 and game._turn == 2, "repeated restart cancels stale CPU callbacks")
+	# Pure rules full-match regression, no simulated outcome shortcuts.
+	var board := ReversiBoard.new()
+	var turn := ReversiBoard.BLACK
+	var steps := 0
+	while not board.is_over() and steps < 130:
+		var legal := board.valid_moves(turn)
+		if not legal.is_empty():
+			board.apply_move(legal.keys()[0], turn)
+		turn = ReversiBoard.opponent(turn)
+		steps += 1
+	check(board.is_over() and board.move_count() <= 60 and board.score(1) + board.score(2) == board.move_count() + 4, "complete deterministic rules match preserves scoring")
+	print("RESULT %d checks, %d failures" % [checks, failures])
+	await wait_seconds(1)
+	quit(1 if failures else 0)
